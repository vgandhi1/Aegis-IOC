# Aegis IOC backend configuration (copy to .env). All keys are optional;
# without them the system runs on simulators + seeded data.

# --- Core ---
# AEGIS_SECRET_KEY is REQUIRED for every AEGIS_ENVIRONMENT except "local"; the
# app refuses to start without it. Left unset locally, a random key is generated
# per process, so tokens do not survive a restart. Minimum 32 characters.
# Generate one:  python -c 'import secrets; print(secrets.token_urlsafe(48))'
# AEGIS_SECRET_KEY=
# AEGIS_ENVIRONMENT=local

# --- Baseline simulators ---
# AEGIS_ENABLE_SIMULATORS=true

# --- Aegis Threat (Cybersecurity) live feeds ---
# AbuseIPDB: https://www.abuseipdb.com/account/api  (free tier 1,000/day)
# AEGIS_ABUSEIPDB_API_KEY=
# Shodan: https://account.shodan.io  (used for on-demand blast-radius enrichment)
# AEGIS_SHODAN_API_KEY=
# Turn on the rate-limited AbuseIPDB ingestion poller (needs the key above):
# AEGIS_ENABLE_LIVE_CYBER=false

# --- Aegis Clinical (HealthTech) live feeds (no key required) ---
# openFDA optional key lifts rate limits: https://open.fda.gov/apis/authentication/
# AEGIS_OPENFDA_API_KEY=
# AEGIS_ENABLE_LIVE_HEALTH=true

# --- Aegis Ledger (FinTech) live feeds ---
# CoinGecko needs no key. Alpha Vantage (FX): https://www.alphavantage.co/support/#api-key
# AEGIS_ALPHAVANTAGE_API_KEY=
# AEGIS_ENABLE_LIVE_FINTECH=true
